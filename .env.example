# Database Connections (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js Authentication (Sole Identity Provider)
AUTH_SECRET="generate_with_openssl_or_auth_cli"
AUTH_URL="http://localhost:3000"

# Email Services (Resend - used for Auth.js Magic Links & Notifications)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Lost Leads <notifications@lostleads.app>"

# Scheduled Cron Security (Daily Digest)
CRON_SECRET="your_secure_cron_secret"
